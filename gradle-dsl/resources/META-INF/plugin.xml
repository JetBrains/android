<idea-plugin package="com.android.tools.idea.gradle.dsl"
             implementation-detail="true"
             xmlns:xi="http://www.w3.org/2001/XInclude">
  <id>org.jetbrains.idea.gradle.dsl</id>
  <name>Gradle DSL API</name>
  <vendor>JetBrains, Google</vendor>
  <description>
    <![CDATA[
    Technical plugin, provides Gradle dsl API
    ]]>
  </description>

  <xi:include href="/META-INF/gradle-dsl.xml" xpointer="xpointer(/idea-plugin/*)"/>

  <dependencies>
    <module name="intellij.java.backend"/>
    <module name="intellij.gradle"/>
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <module name="intellij.java.frontback.psi"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.java.syntax"/>
    <module name="intellij.libraries.commons.lang3"/>
    <module name="intellij.libraries.guava"/>
    <module name="intellij.libraries.kotlinx.collections.immutable"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.codeStyle"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.externalSystem"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.projectModel"/>
    <!-- endregion -->
  </dependencies>

  <content namespace="jetbrains">
    <module name="intellij.android.gradle.dsl.groovy"/>
    <module name="intellij.android.gradle.dsl.kotlin"/>
    <module name="intellij.android.gradle.dsl.toml"/>
    <module name="intellij.android.gradle.dsl.declarative"/>
    <module name="intellij.android.gradle.dsl.flags" />
    <module name="intellij.android.gradle.dsl.android" />
  </content>

</idea-plugin>
